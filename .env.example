# FAIRSHIFT Environment Configuration
# Copy this file to .env or .env.local

# Application Host and Port
HOST=127.0.0.1
PORT=8000
APP_ENV=development

# Database path (SQLite used for local zero-dependency setup)
DATABASE_PATH=data/fairshift.db

# Security & Session Secrets
SECRET_KEY=fairshift-local-development-secret-key-32chars!

# Optional AI API Key (Google Gemini API)
# If left empty, FAIRSHIFT automatically runs fully functional deterministic explainable insights
GEMINI_API_KEY=
